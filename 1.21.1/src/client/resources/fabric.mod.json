{
	"schemaVersion": 1,
	"id": "cabbagejellypack",
	"version": "${version}",
	"name": "Transparent InventoryHud | Fabric-1.21.1",
	"description": "This mod will change the transparency of your inventory UI on the client side",
	"authors": [
		"PinkCabbage"
	],
	"contact": {
		"homepage": "https://www.mcmod.cn/class/21031.html",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC BY-NC 4.0",
	"icon": "assets/cabbagejellypack/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
          "com.fufu.cabbagejellypack.Client.CabbageJellyPackClient"
		]
	},
	"mixins": [
		{
			"config": "cabbagejellypack.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
